<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arts_controllers</name>
  <version>0.1.0</version>
  <description>ros2_control chainable controllers (servo, RCM QP, teleop follower, Ruckig).</description>
  <maintainer email="arts@anonymous.invalid">ARTS Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>generate_parameter_library</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>
  <depend>arts_interfaces</depend>
  <!-- Unversioned by design: rosdep resolves this to ros-jazzy-ruckig (upstream 0.9.2).
       The version is enforced in CMakeLists.txt, not here, because an apt `=` pin breaks
       on a fresh machine when the buildfarm rebuilds the same upstream version. -->
  <depend>ruckig</depend>

  <!-- pinocchio and coal are NOT rosdep keys here on purpose. They are built from source
       into $ARTS_LOCAL from open_source_software/{pinocchio,coal}, and listing them would
       invite rosdep to apt-install a different version into /opt/ros/jazzy, which is
       exactly the shadowing failure the CMake assertions exist to catch. -->

  <!-- proxsuite (the task-layer QP) is built from source like pinocchio and coal, and is
       not a rosdep key for the same reason. -->

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
