<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arts_gui</name>
  <version>0.1.0</version>
  <description>Operator GUI: start and stop ARTS modules one by one, open the surgeon displays and RViz.</description>
  <maintainer email="arts@anonymous.invalid">ARTS Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>arts_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>arts_driver</exec_depend>
  <exec_depend>arts_description</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
