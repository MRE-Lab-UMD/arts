# Isaac Lab / Newton ROS 2 middle overlay.
# Pin FULL COMMIT HASHES only. Never branches.
# Fetched/built into: $ARTS_LOCAL/middle_overlay_ros2_wss/isaac_ros2_ws/
#
# newton_ros has no release tags; pinned to main HEAD as of 2026-08-05.
# Re-pin to a tag when one is published.
repositories:
  newton_ros:
    type: git
    url: https://github.com/vybhav-ibr/newton_ros.git
    version: 94baf7bb19cc77946d00904227467d841b70c446
